{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/manifest.json", "dest": "/public/manifest.json", "headers": { "Content-Type": "application/manifest+json" } },
    { "src": "/sw.js",          "dest": "/public/sw.js",        "headers": { "Content-Type": "application/javascript", "Cache-Control": "no-cache" } },
    { "src": "/config.js",      "dest": "/public/config.js",    "headers": { "Cache-Control": "no-cache" } },
    { "src": "/icon.svg",       "dest": "/public/icon.svg" },
    { "src": "/(.+\\.(?:js|css|ico|png|jpg|svg|woff2?|webmanifest))", "dest": "/public/$1" },
    { "src": "/(.*)",           "dest": "/public/index.html" }
  ]
}
